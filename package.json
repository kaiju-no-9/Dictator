{
  "name": "dictator",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "dev:api": "turbo dev --filter=@dictator/api",
    "dev:web": "turbo dev --filter=@dictator/web",
    "dev:ai": "cd apps/ai-service && uv run uvicorn src.main:app --reload --port 8001",
    "db:generate": "pnpm --filter @dictator/api drizzle-kit generate",
    "db:push": "pnpm --filter @dictator/api drizzle-kit push",
    "db:migrate": "pnpm --filter @dictator/api drizzle-kit migrate",
    "db:studio": "pnpm --filter @dictator/api drizzle-kit studio"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
