# === Database (TS backend) ===
DATABASE_URL=postgresql://dictator:dictator_dev@localhost:5432/dictator

# === Redis (BullMQ) ===
REDIS_URL=redis://localhost:6379

# === S3 / MinIO (TS backend) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=dictator-raw
S3_BUCKET_PROCESSED=dictator-processed
S3_BUCKET_RENDERS=dictator-renders
S3_REGION=us-east-1

# === AI Service URL (TS backend calls this) ===
AI_SERVICE_URL=http://localhost:8001

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter — single API key for all LLM providers
# Get your key at: https://openrouter.ai/keys
# Browse models at: https://openrouter.ai/models
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Planner agent — used for the main edit plan generation
# Recommended: a strong reasoning model
AGENT_PLANNER_MODEL=anthropic/claude-sonnet-4

# Critic agent — used for editorial review/critique pass
# Can be a cheaper/faster model
AGENT_CRITIC_MODEL=google/gemini-2.0-flash

# Agent loop limits
AGENT_MAX_RETRIES=3
AGENT_MAX_TOOL_CALLS=20

# === Transcription (Python AI service) ===
WHISPER_MODEL_SIZE=medium

# === Rendering (TS backend) ===
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# === App Config ===
NODE_ENV=development
API_PORT=8000
AI_SERVICE_PORT=8001
LOG_LEVEL=info

# === Shot Detection (Python AI service) ===
SCENEDETECT_THRESHOLD=27.0

# === Proxy ===
PROXY_RESOLUTION=720
